{
  "name": "portofolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Use pnpm to install dependencies.'); process.exit(1); }\"",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format --write .",
    "prettify": "biome format --write .",
    "lint": "eslint . --ext .ts,.tsx,.astro --fix --config eslint.config.js",
    "check": "biome ci . && eslint . --ext .ts,.tsx,.astro --config eslint.config.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.4.4",
    "@astrojs/react": "^4.4.0",
    "@astrojs/sitemap": "^3.5.1",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^9.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^18.3.0",
    "@vercel/analytics": "^1.5.0",
    "astro": "^5.12.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.43.0"
  }
}
