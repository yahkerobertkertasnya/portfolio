---
import Navbar from "@/components/common/astro/Navbar.astro";
import Layout from "@/components/layouts/Layout.astro";
import SideContacts from "@/components/common/astro/VerticalContacts.astro";
import ExperienceStepper from "@/components/experience/astro/ExperienceStepper.astro";
import ExperienceStepperContent from "@/components/experience/astro/ExperienceStepperContent.astro";
import Footer from "@/components/common/astro/Footer.astro";
import experienceData from "@/config/data/experience.json";
import { StarsBackground } from "@/components/common/react/stars-background";
import { ShootingStars } from "@/components/common/react/shooting-stars";
---

<Layout title="Experience">
  <ShootingStars client:load />
  <StarsBackground client:load />
  <main class="relative flex h-full min-h-[100vh] w-full min-w-[100vw] flex-col items-center">
    <Navbar />
    <SideContacts />

    <div class="flex w-[85%] flex-col items-center max-lg:w-[90%]">
      <div class="flex flex-col items-center gap-6 pt-32">
        <div class="flex items-center gap-3">
          <div class="h-[1px] w-12 bg-white/30"></div>
          <p class="text-lg font-light tracking-wide text-white/70">Experience</p>
          <div class="h-[1px] w-12 bg-white/30"></div>
        </div>
        <h1 class="text-center text-5xl font-bold text-white max-lg:text-3xl">My Experience Over the Years</h1>
      </div>

      <div class="py-16 max-lg:py-12">
        <ExperienceStepper>
          {
            experienceData.map((experience, index) => (
              <ExperienceStepperContent
                data={experience}
                isLast={index === experienceData.length - 1}
              />
            ))
          }
        </ExperienceStepper>
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  :global(.experience-fade-in) {
    animation: fadeIn 0.5s ease-out forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
