---
import Layout from "@/components/layouts/Layout.astro";
import ProjectList from "@/components/works/react/project-list";
import SideContacts from "@/components/common/astro/VerticalContacts.astro";
import Footer from "@/components/common/astro/Footer.astro";
import { professionalWorksData, personalWorksData } from "@/config/data/works.json";
import { StarsBackground } from "@/components/common/react/stars-background";
import { ShootingStars } from "@/components/common/react/shooting-stars";
import Navbar from "@/components/common/astro/Navbar.astro";
import WorksComponent from "@/components/works/astro/Works.astro";
---

<Layout title="Works">
  <ShootingStars client:load />
  <StarsBackground client:load />
  <main class="relative flex h-full min-h-[100vh] w-full min-w-[100vw] flex-col items-center">
    <div class="absolute left-1/2 top-1/2 -z-10 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 animate-pulse-slow bg-[#00ADB5]/5 blur-[120px]"></div>
    <div class="absolute left-1/2 top-1/3 -z-10 h-[500px] w-[500px] -translate-x-1/2 animate-pulse-slow bg-[#088395]/5 blur-[120px]"></div>
    
    <Navbar />
    <SideContacts />
    
    <div class="flex w-[85%] flex-col items-center max-lg:w-[90%]">
      <div class="flex flex-col items-center gap-6 pt-32">
        <div class="flex items-center gap-3">
          <div class="h-[1px] w-12 bg-white/30"></div>
          <p class="text-lg font-light tracking-wide text-white/70">
            Works
          </p>
          <div class="h-[1px] w-12 bg-white/30"></div>
        </div>
        <h1 class="text-center text-5xl font-bold text-white max-lg:text-3xl">
          Featured Projects
        </h1>
      </div>

      <div class="py-16 max-lg:py-12">
        <ProjectList client:load>
          <div class="flex flex-col gap-16 max-lg:gap-12" slot="professionalProjects">
            {professionalWorksData.map((project, index) => (
              <WorksComponent
                data={project}
                inverted={index % 2 === 0}
              />
            ))}
          </div>
          <div class="flex flex-col gap-16 max-lg:gap-12" slot="personalProjects">
            {personalWorksData.map((project, index) => (
              <WorksComponent
                data={project}
                inverted={index % 2 === 0}
              />
            ))}
          </div>
        </ProjectList>
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  :global(.menu-animation) {
    position: relative;
  }

  :global(.menu-animation::after) {
    content: "";
    position: absolute;
    left: 0;
    bottom: -10%;
    width: 100%;
    height: 2px;
    background-color: #00adb4;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.4s ease;
    z-index: 0;
  }

  :global(.menu-animation-disabled::after) {
    transform: scaleX(0) !important;
  }
</style>
