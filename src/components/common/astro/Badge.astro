---
interface Props {
  text: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "md" | "lg";
}

const { 
  text,
  variant = "primary",
  size = "md"
} = Astro.props;

const variants = {
  primary: "bg-[#088395]/10 text-[#088395] hover:bg-[#088395]/20",
  secondary: "bg-[#00ADB5]/10 text-[#00ADB5] hover:bg-[#00ADB5]/20"
};

const sizes = {
  sm: "px-2 py-0.5 text-xs",
  md: "px-3 py-1 text-sm max-lg:px-2.5 max-lg:py-0.5 max-lg:text-xs max-sm:px-2",
  lg: "px-4 py-1.5 text-base max-lg:px-3 max-lg:py-1 max-lg:text-sm"
};
---

<span 
  class:list={[
    "rounded-full shadow-[0_0_10px_rgba(8,131,149,0.1)] transition-all duration-300 hover:shadow-[0_0_15px_rgba(8,131,149,0.2)]",
    variants[variant],
    sizes[size]
  ]}
>
  {text}
</span> 