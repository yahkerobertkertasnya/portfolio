---
import { Image } from "astro:assets";
import { cn } from "@/utils/class-name";
import imageReader from "@/utils/image-reader";

interface Props {
  title: string;
  className?: string;
}

const { className, title } = Astro.props;
---

<div
  class={cn(
    className,
    "flex min-h-64 w-1/3 flex-col gap-4 rounded-[2rem] border border-primary p-10 transition-all duration-300 hover:scale-105 hover:bg-[#393D46] hover:bg-opacity-50 hover:shadow-primary-shiny",
    "max-xl:w-2/5 max-lg:w-3/4 max-lg:min-h-48 max-lg:rounded-[1rem] max-lg:p-6",
    "max-md:w-full max-md:min-h-44 max-md:p-6 max-md:rounded-xl",
    "max-sm:p-4 max-sm:min-h-40 max-sm:rounded-lg",
  )}>
  <div class="flex items-center gap-4 max-xl:gap-3 max-lg:gap-2 max-md:gap-3 max-sm:gap-2">
    <Image
      class="aspect-square w-16 rounded-full object-cover max-xl:w-14 max-lg:w-8 max-md:w-12 max-sm:w-10"
      src={imageReader("/home/dev-icon.png")}
      alt="Temporary Image"
    />
    <span class="text-3xl font-semibold text-white max-xl:text-2xl max-lg:text-lg max-md:text-lg max-sm:text-base">
      {title}
    </span>
  </div>
  <div class="flex w-full text-base max-xl:text-sm max-lg:text-sm max-md:text-sm max-sm:text-xs">
    <slot />
  </div>
</div>
