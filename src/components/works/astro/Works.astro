---
import type { IProject } from "@/models/project";
import { cn } from "@/utils/class-name";
import GithubLineIcon from "@/components/common/icons/astro/GithubLineIcon.astro";
import RedirectLineIcon from "@/components/common/icons/astro/RedirectLineIcon.astro";
import stringPreprocessor from "@/utils/string-preprocessor";
import InteractiveImage from "@/components/common/astro/InteractiveImage.astro";
import Badge from "@/components/common/astro/Badge.astro";
import LiveStatus from "@/components/works/react/LiveStatus.tsx";

interface Props {
  data: IProject;
  inverted: boolean;
}

const {
  data: { title, date, description, techStack, imageUrl, githubUrl, projectUrl, isCollaborative },
  inverted,
} = Astro.props;

const processedDescription = stringPreprocessor(description);
---

<section
  class={cn(
    inverted ? "flex-row max-lg:flex-col" : "flex-row-reverse max-lg:flex-col",
    "flex w-full gap-16 rounded-2xl p-12 transition-all duration-300 hover:bg-[#00ADB5]/5 max-lg:gap-8 max-lg:p-6",
  )}>
  <div class="flex w-[45%] flex-col gap-4 max-lg:w-full">
    <div class="w-full">
      {
        imageUrl.length > 0 && (
          <InteractiveImage
            class="max-h-96 w-full cursor-pointer rounded-xl object-cover transition-transform hover:scale-[102%]"
            width={550}
            height={350}
            src={imageUrl[0]!}
            alt={title}
          />
        )
      }
    </div>
    {
      imageUrl.length > 1 && (
        <div class={cn("flex w-full gap-4 max-lg:gap-2", imageUrl.length > 3 ? "justify-between" : "justify-start")}>
          {imageUrl.slice(1).map(async (url) => {
            return (
              <InteractiveImage
                class="max-h-32 w-[31%] cursor-pointer rounded-lg object-cover transition-transform hover:scale-[102%]"
                width={550}
                height={250}
                src={url}
                alt={title}
              />
            );
          })}
        </div>
      )
    }
  </div>
  <div class="flex w-[55%] flex-col items-start justify-center max-lg:w-full">
    <LiveStatus projectUrl={projectUrl} client:load>
      <div class="relative flex items-center">
        <span class="absolute -left-0.5 inline-flex h-4 w-4 animate-ping rounded-full bg-red-500 opacity-75" />
        <span class="relative inline-flex h-3 w-3 rounded-full bg-red-500" />
        <p class="ps-3 text-base text-white max-lg:text-sm">LIVE</p>
      </div>
    </LiveStatus>
    <h4 class="flex items-center gap-2 text-3xl font-semibold text-white max-lg:text-lg">
      <span class="pe-4">{title}</span>
      {
        githubUrl?.map((url) => {
          return (
            <a
              target="_blank"
              href={url}
              class="w-8 cursor-pointer stroke-white transition-colors hover:stroke-[#00ADB5] max-lg:w-6 max-lg:min-w-6"
              rel="noreferrer">
              <GithubLineIcon />
            </a>
          );
        })
      }
      <LiveStatus projectUrl={projectUrl} client:load>
        <a
          target="_blank"
          href={projectUrl}
          class="w-8 cursor-pointer stroke-white transition-colors hover:stroke-[#00ADB5] max-lg:w-6 max-lg:min-w-6"
          rel="noreferrer">
          <RedirectLineIcon />
        </a>
      </LiveStatus>
    </h4>
    <p class="pb-4 text-white/50 max-lg:text-sm">{date} • {isCollaborative ? "Collaborative" : "Personal"}</p>
    <div
      class="py-4 text-base text-white/80 max-lg:text-sm"
      set:html={processedDescription}
    />
    <div class="flex flex-wrap gap-2 pt-4">
      {
        techStack.map((tech) => (
          <Badge text={tech} />
        ))
      }
    </div>
  </div>
</section>
